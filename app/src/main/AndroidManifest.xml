<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.WRITE_CONTACTS" />
    <!-- Optional: asked for during setup, from the Permissions section of the format options,
         and when the user picks a call through an app that requires it (WhatsApp, Signal,
         Telegram…) without having granted it. Regular calls open the dialer and never need it. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- CALL_PHONE implies telephony; keep the app available on tablets without it. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <!-- TidyDial works fully offline: strip network access even if a dependency asks for it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Package visibility for calling: whether a phone app can open a number, and which app
         opens a contact's call or chat entry (WhatsApp, Signal…). Calls are only handed to those
         apps; TidyDial never places a call itself. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <!-- The authority matters: WhatsApp's filter names it, and stays hidden otherwise. -->
            <data
                android:host="com.android.contacts"
                android:mimeType="vnd.android.cursor.item/*"
                android:scheme="content" />
        </intent>
    </queries>

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TidyDial.Starting"
        tools:targetApi="33">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
