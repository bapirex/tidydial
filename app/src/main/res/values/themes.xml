<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.TidyDial.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TidyDial</item>
    </style>

    <!-- Compose draws everything; this only covers the window before the first frame. -->
    <style name="Theme.TidyDial" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

</resources>
