<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: the undo journal holds phone numbers. It lives in noBackupFilesDir, which is never
    backed up or transferred. These rules also keep any copy in files/ (and its temporary file) out
    of cloud backup and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude
            domain="file"
            path="undo_journal.json" />
        <exclude
            domain="file"
            path="undo_journal.json.tmp" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="undo_journal.json" />
        <exclude
            domain="file"
            path="undo_journal.json.tmp" />
    </device-transfer>
</data-extraction-rules>
