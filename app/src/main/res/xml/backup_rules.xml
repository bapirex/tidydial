<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower: the undo journal (phone numbers) lives in noBackupFilesDir, which is never
    backed up. Any copy in files/ and its temporary file are excluded as well.

    The backup settings (and the temporary file DataStore writes them through) are excluded too: the
    backup folder's access grant does not carry over to a new install, and a new install writes a
    new snapshot. So is the record of refused permissions, which only describes this install.
-->
<full-backup-content>
    <exclude
        domain="file"
        path="undo_journal.json" />
    <exclude
        domain="file"
        path="undo_journal.json.tmp" />
    <exclude
        domain="file"
        path="datastore/backup.preferences_pb" />
    <exclude
        domain="file"
        path="datastore/backup.preferences_pb.tmp" />
    <exclude
        domain="sharedpref"
        path="permission_refusals.xml" />
</full-backup-content>
